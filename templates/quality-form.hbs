{{! templates/quality-form.hbs }}
<div class="lookfar-extension-quality-form">
<div class="form-group">
    <label>Nombre</label>
    <input type="text" name="name" value="{{quality.name}}" placeholder="Shadowfire" required autofocus />
</div>

<div class="form-group">
    <label>ID (identificador único)</label>
    <input type="text" name="id" value="{{quality.id}}" placeholder="shadowfire" {{#if (not isNew)}}readonly{{/if}} />
    <p class="hint">Minúsculas, números y guiones. Si lo dejas vacío, se genera desde el nombre.</p>
</div>

<div class="form-group">
    <label>Descripción</label>
    <textarea name="description" rows="3" placeholder="El ataque ignora la resistencia al daño de fuego.">{{quality.description}}</textarea>
</div>

<div class="form-group">
    <label>Coste (zenit)</label>
    <input type="number" name="cost" value="{{quality.cost}}" min="0" step="50" />
</div>

<div class="form-group">
    <label>Aplica a</label>
    <div class="checkbox-row">
        {{#each types}}
        <label class="checkbox">
            <input type="checkbox" name="appliesTo.{{this.key}}" {{#if (lfIncludes ../quality.appliesTo this.key)}}checked{{/if}} />
            {{this.label}}
        </label>
        {{/each}}
    </div>
</div>

<footer class="form-footer">
    <button type="submit"><i class="fas fa-save"></i> Guardar</button>
</footer>
</div>