{{! templates/editor.hbs }}
<div class="lookfar-extension-editor">
    <div class="editor-header">
        <button type="button" data-action="manageCategories">
            <i class="fas fa-tags"></i> {{localize "LOOKFAR_EXT.Editor.ManageCategories"}}
        </button>
        <button type="button" data-action="addQuality">
            <i class="fas fa-plus"></i> {{localize "LOOKFAR_EXT.Editor.AddQuality"}}
        </button>
    </div>

    <div class="qualities-scroll">
        {{#if hasQualities}}
            {{#each categories}}
            <div class="category-group">
                <h3 class="category-title">
                    <i class="fas fa-folder"></i> {{this.name}}
                    <span class="category-count">({{this.qualities.length}})</span>
                </h3>
                <table class="qualities-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Coste</th>
                            <th>Aplica a</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each this.qualities}}
                        <tr>
                            <td><code>{{this.id}}</code></td>
                            <td>{{this.name}}</td>
                            <td>{{this.cost}} z</td>
                            <td>
                                {{#each this.appliesTo}}
                                <span class="tag">{{this}}</span>
                                {{/each}}
                            </td>
                            <td class="actions">
                                <button type="button" data-action="editQuality" data-id="{{this.id}}" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button type="button" data-action="deleteQuality" data-id="{{this.id}}" title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{/each}}
        {{else}}
        <p class="empty">No hay cualidades personalizadas todavía. Pulsa "Añadir Cualidad" para crear la primera.</p>
        {{/if}}
    </div>
</div>